# Site
NEXT_PUBLIC_SITE_URL=https://tehuset.example

# TinaCMS local/dev. For self-hosted production, point these to your git-backed Tina auth/content service.
NEXT_PUBLIC_TINA_CLIENT_ID=local
TINA_TOKEN=local
GITHUB_BRANCH=main

# Swish. Leave SWISH_DEMO_MODE=true until certificates/API proxy are configured.
SWISH_DEMO_MODE=true
SWISH_API_URL=https://mss.cpc.getswish.net/swish-cpcapi
SWISH_PAYEE_ALIAS=
SWISH_CALLBACK_URL=https://tehuset.example/api/swish/callback

# Email confirmation to adminEmail from content/site.json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ORDER_EMAIL_FROM=
